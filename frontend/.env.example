# ---------------------------------------------------------------------------
# Department Activity Planner - frontend environment (คัดลอกเป็น .env.local)
# frontend ห้ามมี DATABASE_URL — ต้องคุยผ่าน backend เท่านั้น (ARC-01)
# ---------------------------------------------------------------------------

# NestJS backend ของระบบย่อยนี้ (ฝั่ง server เท่านั้น)
BACKEND_URL=http://127.0.0.1:4202

# ปุ่มเข้าสู่ระบบเริ่มที่ /auth/login แล้ว backend ส่งต่อไป Core Hub

# ต้องตรงกับ name ใน Subsystem Registry และ subsystem.yaml
SUBSYSTEM_ID=csmju-department-activity-planner

