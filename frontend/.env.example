# ---------------------------------------------------------------------------
# Department Activity Planner - frontend environment (คัดลอกเป็น .env.local)
# frontend ห้ามมี DATABASE_URL — ต้องคุยผ่าน backend เท่านั้น (ARC-01)
# ---------------------------------------------------------------------------

# NestJS backend ของระบบย่อยนี้ (ฝั่ง server เท่านั้น)
BACKEND_URL=http://127.0.0.1:4202

# หน้าเว็บ Core Hub ที่ผู้ใช้ login — ปุ่ม "เข้าสู่ระบบ" พาไปที่ /api/sso/<name> ของที่นี่
# ต้องเป็น host เดียวกับที่ผู้ใช้ login Core Hub (คุกกี้ของ Core Hub ผูกกับ host)
CORE_HUB_WEB_URL=http://127.0.0.1:3100

# ต้องตรงกับ name ใน Subsystem Registry และ subsystem.yaml
SUBSYSTEM_ID=csmju-department-activity-planner

# TEMPORARY (until Core Hub login is connected): no sign-in; the backend answers as its
# LOCAL_TEST_ROLE user. Use together with LOCAL_TEST_ROLE in backend/.env. Ignored in production.
LOCAL_DEV_AUTH=
