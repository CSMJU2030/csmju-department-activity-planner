  "info": {
    "title": "Department Activity Planner API",
    "description": "CSMJU2030 subsystem. Every success response is wrapped as { success, data[, meta] }; errors as { success: false, error: { code, message, details } }.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateActivityDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "enum": [
              "workshop",
              "seminar",
              "competition",
              "volunteer",
              "recreation",
              "academic",
              "other"
            ]
          },
          "location": {
            "type": "string",
            "maxLength": 200
          },
          "maxParticipants": {
            "type": "number",
            "minimum": 1,
            "maximum": 2147483647
          },
          "startAt": {
            "type": "string"
          },
          "endAt": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "category",
          "maxParticipants",
          "startAt",
          "endAt"
        ]
      },
      "UpdateActivityDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "enum": [
              "workshop",
              "seminar",
              "competition",
              "volunteer",
              "recreation",
              "academic",
              "other"
            ]
          },
          "location": {
            "type": "string",
            "maxLength": 200
          },
          "maxParticipants": {
            "type": "number",
            "minimum": 1,
            "maximum": 2147483647
          },
          "startAt": {
            "type": "string"
          },
          "endAt": {
            "type": "string"
          }
        }
      },
      "UpdateActivityStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "FULL",
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateActivityRoleDto": {
        "type": "object",
        "properties": {
          "roleName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "maxMembers": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "roleName",
          "maxMembers"
        ]
      },
      "RespondApplicationDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "REJECTED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateEvaluationDto": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "liked": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "improvement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "rating",
          "liked",
          "improvement"
        ]
      }
    }
  }
