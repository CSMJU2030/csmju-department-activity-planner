{
  "name": "csmju-department-activity-planner",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter backend --filter frontend start:dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter backend test:e2e",
    "checks": "./standards/scripts/run-all-checks.sh .",
    "conformance": "node standards/conformance/run.js"
  }
}
